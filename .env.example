PIHOLE_PASSWORD=changeme
# These are named for our two Samba users (see samba/smb.conf.example and
# compose.yaml's samba `command:` block) — rename to your own usernames in
# all three places if you use different ones.
SAMBA_EVAN_PASSWORD=changeme
SAMBA_KARLA_PASSWORD=changeme
WG_PASSWORD_HASH=changeme
DDNS_HOSTNAME=changeme
SERVER_LAN_IP=changeme
# WireGuard private key from account.proton.me/u/0/vpn/WireGuard — when
# creating it, check "NAT-PMP (Port Forwarding)" so gluetun's port
# forwarding works. Tied to a specific server, not portable like a
# username/password.
PROTONVPN_WIREGUARD_PRIVATE_KEY=changeme
# Generated manually in Jellyfin's Dashboard > Advanced > API Keys (there's
# no first-run auto-generated key like Radarr/Sonarr) — only needed for
# Homepage's Jellyfin widget.
JELLYFIN_API_KEY=changeme
RADARR_API_KEY=changeme
QBITTORRENT_USERNAME=changeme
QBITTORRENT_PASSWORD=changeme
WG_ADMIN_PASSWORD=changeme
SONARR_API_KEY=changeme
# Google Calendar > Settings > [calendar] > Integrate calendar > Secret
# address in iCal format. Grants read access to that calendar — treat it
# like a password. Leave as changeme to skip the calendar widget's Google
# Calendar feed (Sonarr/Radarr release calendars still work without it).
GCAL_ICS_URL=changeme
# Free API key from https://finnhub.io/register (no card required), used by
# the stocks widget.
FINNHUB_API_KEY=changeme
# HTTP basic auth for the webtop remote desktop (http://desktop.evan) — pick
# your own username/password. This is "keep it off casual LAN access" level
# auth, not internet-grade (see README's Webtop notes) — the desktop's
# terminal has passwordless sudo, so don't forward this past your LAN.
WEBTOP_USERNAME=changeme
WEBTOP_PASSWORD=changeme
