YOUR_USERNAME ALL=(root) NOPASSWD: /usr/bin/apt-get update, /usr/bin/apt-get full-upgrade -y
YOUR_USERNAME ALL=(root) NOPASSWD: /usr/bin/cat /path/to/homeserver/wireguard/wg0.conf, /usr/bin/cat /path/to/homeserver/wireguard/wg0.json
YOUR_USERNAME ALL=(root) NOPASSWD: /usr/bin/dmesg, /usr/bin/dmesg *, /usr/bin/journalctl, /usr/bin/journalctl *
