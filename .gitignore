# Secrets
.env

# Plex — large binary database, auth tokens, watch history
plex/config/
plex/transcode/

# Jellyfin — large binary database, auth tokens, watch history (like Plex)
jellyfin/config/

# WireGuard — actual private keys for every peer
wireguard/

# Pi-hole — runtime database, query logs (not hand-edited config)
pihole/etc-pihole/
pihole/etc-dnsmasq.d/

# Caddy — may contain TLS keys/certs, autosave state
caddy/data/
caddy/config/

# ddclient — contains No-IP credentials directly
ddclient/ddclient.conf

# Samba — real usernames/shares/paths are specific to each setup
samba/smb.conf

# Maintenance sudoers rule — contains your actual Linux username
scripts/homeserver-maintenance.sudoers

# gluetun - runtime state, cached server lists
gluetun/

# qBittorrent - runtime config/session state
qbittorrent/

# prowlarr
prowlarr/

# radarr
radarr/

# sonarr — runtime config, API keys
sonarr/

# uptime-kuma — runtime database (monitors, history, admin credentials)
uptime-kuma/

# webtop — desktop/browser/Discord profile data, session tokens
webtop/config/

# Homepage — dashboard config is personalized (weather location, stock
# watchlist, bookmarks) — start from the .example files
# (kubernetes.yaml/proxmox.yaml are unused generated stubs, not personalized
# config, so they're left tracked as-is)
homepage/config/services.yaml
homepage/config/widgets.yaml
homepage/config/bookmarks.yaml
homepage/config/settings.yaml
homepage/config/docker.yaml
homepage/config/logs/
