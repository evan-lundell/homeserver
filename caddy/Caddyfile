# All plain-http sites live in this one block so the friend check below is a
# single default-deny choke point: friends' WireGuard peers (10.8.0.200/29,
# see the wireguard WG_POST_UP rules in compose.yaml) only get the hosts
# listed in `not host`, and any site added here later is hidden from them
# automatically. To add a service: a matcher plus a `handle` below.
http://*.evan {
    @friend_blocked {
        remote_ip 10.8.0.200/29
        not host jellyfin.evan
    }
    # `handle` blocks are mutually exclusive and run in the order written
    # here, so this one has to stay first.
    handle @friend_blocked {
        abort
    }

    @jellyfin host jellyfin.evan
    handle @jellyfin {
        reverse_proxy localhost:8096
    }

    @pihole host pihole.evan
    handle @pihole {
        redir / /admin
        reverse_proxy localhost:8080
    }

    @wireguard host wireguard.evan
    handle @wireguard {
        reverse_proxy localhost:51821
    }

    @prowlarr host prowlarr.evan
    handle @prowlarr {
        reverse_proxy localhost:9696
    }

    @qbittorrent host qbittorrent.evan
    handle @qbittorrent {
        reverse_proxy localhost:8081
    }

    @radarr host radarr.evan
    handle @radarr {
        reverse_proxy localhost:7878
    }

    @dashboard host dashboard.evan
    handle @dashboard {
        reverse_proxy localhost:3000
    }

    @sonarr host sonarr.evan
    handle @sonarr {
        reverse_proxy localhost:8989
    }

    @bazarr host bazarr.evan
    handle @bazarr {
        reverse_proxy localhost:6767
    }

    @uptime host uptime.evan
    handle @uptime {
        reverse_proxy localhost:3001
    }

    @kapowarr host kapowarr.evan
    handle @kapowarr {
        reverse_proxy localhost:5656
    }

    @shelfmark host shelfmark.evan
    handle @shelfmark {
        reverse_proxy localhost:8084
    }

    @kavita host kavita.evan
    handle @kavita {
        reverse_proxy localhost:5000
    }

    @nuzlocke host nuzlocke.evan
    handle @nuzlocke {
        reverse_proxy localhost:3456
    }

    # Sunshine itself is served by the https:// block below, but this
    # wildcard claims sunshine.evan on port 80 too, which disables Caddy's
    # automatic http->https redirect for it — without this, a bare
    # "sunshine.evan" typed into a browser falls through to the abort.
    @sunshine host sunshine.evan
    handle @sunshine {
        redir https://{host}{uri} permanent
    }

    handle {
        abort
    }
}

https://sunshine.evan {
    # Sunshine's CSRF protection hard-requires https:// origins (see its
    # source, config.cpp — no http:// entry is ever accepted, regardless
    # of what's in csrf_allowed_origins), unlike every other service here.
    # `tls internal` uses Caddy's own local CA instead of ACME, since real
    # certs don't work for the made-up .evan TLD — expect a one-time
    # browser trust prompt for this domain specifically.
    tls internal
    reverse_proxy https://localhost:47990 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}

# Public internet-facing Jellyfin, deliberately its own site block rather
# than folded into the `*.evan` wildcard above — Caddy routes by exact Host
# header, so this can never accidentally expose any of the internal .evan
# services, and this block can never match an internal .evan request either.
# Real cert via HTTP-01 (needs port 80 reachable, same as 443 — Caddy
# handles the challenge and redirects everything else to HTTPS).
jellyfin.evanlundell.fyi {
    log {
        output file /var/log/caddy/jellyfin-access.log
        format json
    }
    reverse_proxy localhost:8096
}
